<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="mobilna.MainPage">

    <VerticalStackLayout
        BackgroundColor="#F5F5DC"
        Padding="0"
        Spacing="10">

        <Label
            Text="Gra w kości. Autor XXX"
            BackgroundColor="#A52A2A"
            TextColor="#FFFFFF"
            FontSize="28"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center"
            HorizontalOptions="Fill"
            Margin="0,0,0,10"
            Padding="10" />

        <Button
            Text="RZUĆ KOŚĆMI"
            BackgroundColor="#D2691E"
            TextColor="#FFFFFF"
            HorizontalOptions="Center"
            Margin="10"
            Clicked="Rzuc" />

        <HorizontalStackLayout
            BackgroundColor="#FFFFFF"
            HorizontalOptions="Fill"
            Spacing="0"
            Padding="0">

            <Image
                x:Name="zdj1"
                Source="question.jpg"
                HeightRequest="60"
                Aspect="AspectFit"
                HorizontalOptions="FillAndExpand"
                Margin="9,0" />

            <Image
                x:Name="zdj2"
                Source="question.jpg"
                HeightRequest="60"
                Aspect="AspectFit"
                HorizontalOptions="FillAndExpand"
                Margin="9,0" />

            <Image
                x:Name="zdj3"
                Source="question.jpg"
                HeightRequest="60"
                Aspect="AspectFit"
                HorizontalOptions="FillAndExpand"
                Margin="9,0" />

            <Image
                x:Name="zdj4"
                Source="question.jpg"
                HeightRequest="60"
                Aspect="AspectFit"
                HorizontalOptions="FillAndExpand"
                Margin="9,0" />

            <Image
                x:Name="zdj5"
                Source="question.jpg"
                HeightRequest="60"
                Aspect="AspectFit"
                HorizontalOptions="FillAndExpand"
                Margin="9,0" />

        </HorizontalStackLayout>

        <Label
            x:Name="wynikLosowania"
            Text="Wynik tego losowania: 0"
            FontSize="18"
            HorizontalTextAlignment="Center"
            HorizontalOptions="Fill"
            Margin="10" />

        <Label
            x:Name="wynikGryLbl"
            Text="Wynik gry: 0"
            FontSize="18"
            HorizontalTextAlignment="Center"
            HorizontalOptions="Fill"
            Margin="10" />

        <Button
            Text="RESETUJ WYNIK"
            BackgroundColor="#D2691E"
            TextColor="#FFFFFF"
            HorizontalOptions="Center"
            Margin="10"
            Clicked="Resetuj" />

    </VerticalStackLayout>
</ContentPage>
/************************************************
 nazwa: Rzuc
 opis: Losuje wartości pięciu kości, wyświetla
       odpowiadające im obrazy, oblicza punkty
       za powtarzające się wartości oczek
       i aktualizuje wynik całej gry.
 parametry:
       sender - obiekt wywołujący zdarzenie,
       e - argumenty zdarzenia.
 zwracany typ i opis:
       void - metoda nie zwraca wartości.
************************************************/